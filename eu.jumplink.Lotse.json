{
  "id": "eu.jumplink.Lotse",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.typescript"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node24/bin:/usr/lib/sdk/typescript/bin:/app/bin"
  },
  "command": "lotse-app",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=host"
  ],
  "modules": [
    {
      "name": "opencode",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 apply_extra /app/bin/apply_extra"
      ],
      "sources": [
        {
          "type": "extra-data",
          "filename": "opencode.tar.gz",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-2.1.4.tgz",
          "sha256": "ce05abe2dce1041391c8ec8cdb8da066f640fd471e72ac846dcb089c441e11e1",
          "size": 113868298
        },
        {
          "type": "extra-data",
          "filename": "opencode.tar.gz",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://registry.npmjs.org/@opencode/cli-linux-arm64/-/cli-linux-arm64-2.1.4.tgz",
          "sha256": "e9acb4e23a9ac432139693aa166455a6add8946533394cbe083459a48e788861",
          "size": 112482911
        },
        {
          "type": "script",
          "dest-filename": "apply_extra",
          "commands": [
            "set -e",
            "mkdir -p /app/extra/agents/opencode",
            "tar -xzf /app/extra/opencode.tar.gz -C /app/extra/agents/opencode",
            "chmod 0755 /app/extra/agents/opencode/package/bin/opencode",
            "rm -f /app/extra/opencode.tar.gz"
          ]
        }
      ]
    },
    {
      "name": "lotse",
      "buildsystem": "simple",
      "build-commands": [
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs install --immutable",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace lotse-cli build",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace lotse-cli build:app",
        "install -d /app/bin",
        "printf '#!/usr/bin/gjs -m\\n' > /app/bin/lotse-app",
        "cat app/dist/lotse-app.gjs.mjs >> /app/bin/lotse-app",
        "chmod 0755 /app/bin/lotse-app",
        "printf '#!/usr/bin/gjs -m\\n' > /app/bin/lotse",
        "cat app/dist/lotse.gjs.mjs >> /app/bin/lotse",
        "chmod 0755 /app/bin/lotse",
        "for mo in app/dist/locale/*/LC_MESSAGES/*.mo; do lang=${mo#app/dist/locale/}; lang=${lang%%/*}; install -Dm644 \"$mo\" \"/app/share/locale/$lang/LC_MESSAGES/$(basename $mo)\"; done",
        "install -Dm644 data/eu.jumplink.Lotse.desktop /app/share/applications/eu.jumplink.Lotse.desktop",
        "install -Dm644 data/eu.jumplink.Lotse.metainfo.xml /app/share/metainfo/eu.jumplink.Lotse.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/eu.jumplink.Lotse.svg /app/share/icons/hicolor/scalable/apps/eu.jumplink.Lotse.svg",
        "install -Dm644 data/icons/hicolor/symbolic/apps/eu.jumplink.Lotse-symbolic.svg /app/share/icons/hicolor/symbolic/apps/eu.jumplink.Lotse-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/JumpLink/lotse.git",
          "tag": "v0.5.0",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$",
            "version-scheme": "semantic"
          }
        },
        {
          "type": "file",
          "path": "build-aux/gjsify.gjs.mjs"
        },
        "gjsify-sources.json"
      ]
    }
  ]
}
