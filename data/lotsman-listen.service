# systemd user unit for `lotsman listen` — an example, not installed by anything in this repository.
#
#   install -Dm644 data/lotsman-listen.service ~/.config/systemd/user/lotsman-listen.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now lotsman-listen.service
#
# `listen` only receives (chat requests, answers, question notices); it starts no task by itself. To run
# a task on a timer, add your own timer that calls `lotsman run <id>` (docs/tasks.md).
#
# Point ExecStart at your own `lotsman`. `listen` reads users.json, profiles.json and settings.json at
# start: `systemctl --user restart lotsman-listen` after editing them. A task's SKILL.md is read per run.

[Unit]
Description=lotsman listen: messenger requests and questions
Documentation=https://github.com/JumpLink/lotsman/blob/main/docs/listen.md
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lotsman listen --quiet
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
