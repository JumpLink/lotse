# systemd user unit for `lotse serve` — an example, not installed by anything in this repository.
#
#   install -Dm644 data/lotse-serve.service ~/.config/systemd/user/lotse-serve.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now lotse-serve.service
#
# Point ExecStart at your own `lotse`. `serve` reloads tasks.json and its prompt files in place
# (ADR 0003), so an edit needs no restart; `systemctl --user restart lotse-serve` is for settings.json.

[Unit]
Description=lotse serve: messenger requests and questions
Documentation=https://github.com/JumpLink/lotse/blob/main/docs/serve.md
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lotse serve --quiet
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
