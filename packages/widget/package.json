{
  "name": "@lotsman/widget",
  "version": "0.6.0",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "description": "The chat surface, as a widget a host embeds: LotsmanChat renders one conversation — transcript, composer, model and mode controls, the tool and thought cards, the permission dialog — over @lotsman/core's AgentSession. GTK/Adw, no app shell: the host passes the agent choice, the paths, the cwd, its mcpServers and its own permission gate.",
  "keywords": [
    "acp",
    "gtk4",
    "libadwaita",
    "gjs",
    "gjsify",
    "widget",
    "coding-agent"
  ],
  "homepage": "https://github.com/JumpLink/lotsman/tree/main/packages/widget#readme",
  "bugs": {
    "url": "https://github.com/JumpLink/lotsman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JumpLink/lotsman.git",
    "directory": "packages/widget"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./tool-line": "./src/tool-line.ts",
    "./permission-dialog": "./src/permission-dialog.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit --project tsconfig.json"
  },
  "files": [
    "src",
    "po",
    "COPYING",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@lotsman/acp": "^0.6.0",
    "@lotsman/core": "^0.6.0",
    "@lotsman/session": "^0.6.0"
  },
  "peerDependencies": {
    "@girs/adw-1": "^5.5.0",
    "@girs/gdk-4.0": "^5.5.0",
    "@girs/glib-2.0": "^5.5.0",
    "@girs/gobject-2.0": "^5.5.0",
    "@girs/gtk-4.0": "^5.5.0",
    "@girs/pango-1.0": "^5.5.0"
  },
  "devDependencies": {
    "@girs/adw-1": "5.5.0",
    "@girs/gdk-4.0": "5.5.0",
    "@girs/glib-2.0": "5.5.0",
    "@girs/gobject-2.0": "5.5.0",
    "@girs/gtk-4.0": "5.5.0",
    "@girs/pango-1.0": "5.5.0"
  }
}
