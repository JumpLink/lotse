    "acp",
    "agent-client-protocol",
    "json-rpc",
    "coding-agent"
  ],
  "homepage": "https://github.com/JumpLink/lotse/tree/main/packages/acp#readme",
  "bugs": {
    "url": "https://github.com/JumpLink/lotse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JumpLink/lotse.git",
    "directory": "packages/acp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./gate": "./src/gate.ts",
    "./jsonrpc": "./src/jsonrpc.ts",
    "./methods": "./src/methods.ts",
    "./narrow": "./src/narrow.ts",
    "./transport": "./src/transport.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit --project tsconfig.json"
  },
  "files": [
    "src",
    "COPYING",
    "LICENSE",
    "README.md"
  ]
}
