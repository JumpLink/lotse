msgstr ""
"Wie lotse serve eine Frage eines Agenten anzeigt. Eine Änderung gilt für die "
"nächste Frage."

#: app/src/frontends/gui/preferences.ts:95
msgid "Notification"
msgstr "Benachrichtigung"

#: app/src/frontends/gui/preferences.ts:96
