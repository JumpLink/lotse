{
  "name": "lotsman-cli",
  "version": "0.6.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Lotsman app: the `lotsman` binary \u2014 a CLI over @lotsman/acp and @lotsman/session, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit && gjsify run check:i18n",
    "check:i18n": "node ../dev/check-i18n.js",
    "i18n:extract": "../dev/i18n.sh extract",
    "i18n:compile": "../dev/i18n.sh compile",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run i18n:compile && gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/lotsman.gjs.mjs",
    "build:app": "gjsify run i18n:compile && gjsify build src/frontends/gui/main.ts --app gjs --outfile dist/lotsman-app.gjs.mjs",
    "build:app:node": "gjsify build src/frontends/gui/main.ts --app node --outfile dist/lotsman-app.node.mjs",
    "start": "gjsify run dist/lotsman.gjs.mjs",
    "start:app": "gjsify run dist/lotsman-app.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "dev:app": "gjsify run build:app && gjsify run start:app",
    "test": "gjsify test",
    "test:real-agent": "gjsify build tests/integration/acp-real-agent.ts --app gjs --outfile dist/acp-real-agent.gjs.mjs && gjsify run dist/acp-real-agent.gjs.mjs",
    "test:i18n": "gjsify run i18n:compile && gjsify build tests/probes/i18n-de.ts --app gjs --outfile dist/i18n-de.gjs.mjs && LANGUAGE=de LANG=de_DE.UTF-8 gjsify run dist/i18n-de.gjs.mjs",
    "test:schema": "node ../scripts/check-schema.mjs"
  },
  "gjsify": {
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    },
    "ship": {
      "appId": "eu.jumplink.Lotsman",
      "binaryName": "lotsman-app",
      "kind": "app",
      "name": "Lotsman",
      "bundle": {
        "linux": "dist/lotsman-app.gjs.mjs",
        "darwin": "dist/lotsman-app.node.mjs",
        "win32": "dist/lotsman-app.node.mjs"
      },
      "app": {
        "darwin": "node",
        "win32": "node"
      },
      "localeDir": "dist/locale",
      "icon": "../data/icons/hicolor/scalable/apps/eu.jumplink.Lotsman.svg",
      "categories": [
        "Development",
        "GTK"
      ],
      "keywords": [
        "ACP",
        "agent",
        "coding assistant",
        "AI",
        "session",
        "Adwaita",
        "GNOME"
      ],
      "developer": {
        "id": "eu.jumplink",
        "name": "Pascal Garber",
        "email": "pascal@jumplink.eu"
      },
      "summary": "Start coding agents as subprocesses and drive their sessions",
      "license": {
        "project": "AGPL-3.0-or-later"
      },
      "description": "Lotsman is a client for the Agent Client Protocol (ACP). It starts an agent such as OpenCode as a subprocess, keeps the conversation, and shows what the agent says while it works. The agent and the model behind it are not part of Lotsman.",
      "homepageUrl": "https://github.com/JumpLink/lotsman",
      "bugtrackerUrl": "https://github.com/JumpLink/lotsman/issues",
      "vcsBrowserUrl": "https://github.com/JumpLink/lotsman",
      "flatpak": {
        "finishArgs": [
          "--device=dri",
          "--share=ipc",
          "--share=network",
          "--socket=fallback-x11",
          "--socket=wayland",
          "--talk-name=org.freedesktop.Flatpak",
          "--filesystem=host"
        ]
      }
    }
  },
  "dependencies": {
    "@lotsman/acp": "^0.6.0",
    "@lotsman/core": "^0.6.0",
    "@lotsman/session": "^0.6.0",
    "@lotsman/widget": "^0.6.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@gjsify/cli": "0.64.32",
    "@gjsify/node-globals": "0.64.32",
    "@gjsify/rolldown-native": "0.64.32",
    "@gjsify/runtime": "0.64.32",
    "@gjsify/unit": "0.64.32",
    "@gjsify/ws": "0.64.32",
    "@types/node": "^26.6.5",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "@gjsify/adwaita-app": "0.64.32"
  }
}
