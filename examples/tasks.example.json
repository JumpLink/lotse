{
  "version": 1,
  "users": [{ "id": "me", "addresses": [] }],
  "profiles": [
    { "id": "private", "user": "me", "data": "private", "model": "<provider>/<paid-model-id>" },
    { "id": "public", "user": "me", "agent": "opencode", "data": "public" },
    { "id": "private-check", "user": "me", "data": "private", "model": "<provider>/<small-model-id>" }
  ],
  "tasks": [
    {
      "id": "morning-summary",
      "profile": "private",
      "schedule": { "at": "07:30", "days": ["mon", "tue", "wed", "thu", "fri"] },
      "promptFile": "prompts/morning-summary.md",
      "cwd": "/path/to/a/working/directory",
      "mcpServers": [
        {
          "name": "<server-name>",
          "command": "/path/to/an/mcp/server",
          "args": ["mcp"],
          "env": [{ "name": "<VARIABLE>", "value": "<value>" }]
        }
      ],
      "rights": "confirm",
      "questions": { "expiresIn": "12h", "maxOpen": 3, "maxPerHour": 6 },
      "notify": "always",
      "precheck": {
        "profile": "private-check",
        "prompt": "Is there anything new since the last run? End with WORK or NOTHING on the last line."
      }
    },
    {
      "id": "watch-something-public",
      "profile": "public",
      "schedule": { "every": "6h" },
      "prompt": "Check <a public source> and ask me if anything needs a decision.",
      "cwd": "/path/to/a/working/directory",
      "mcpServers": [],
      "rights": "read"
    }
  ]
}
